# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real values.

# Google Apps Script web app URL (dev data source)
# Deploy via: Google Sheet → Extensions → Apps Script → Deploy → Web app
# Execute as: Me | Who has access: Anyone
SHEETS_API_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
